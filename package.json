{
  "name": "raven",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "HUTCH_HOME=\"$PWD/.hutch\" bunx electrobun@2.0.1 dev --watch",
    "start": "HUTCH_HOME=\"$PWD/.hutch\" bunx electrobun@2.0.1 run",
    "build": "HUTCH_HOME=\"$PWD/.hutch\" bunx electrobun@2.0.1 build --env=stable",
    "prepare:devkit": "HUTCH_HOME=\"$PWD/.hutch\" bunx electrobun@2.0.1 prepare",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "server": "bun server/bin/app.ts",
    "proto": "cd proto && PATH=\"$PWD/../node_modules/.bin:$PATH\" bunx buf generate"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
