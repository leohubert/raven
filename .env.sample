# Every value has a default; override only when you need to.
# The toolchain requires an ABSOLUTE path - a relative HUTCH_HOME makes every
# `electrobun` command fail with a bare `error: FileNotFound`.
HUTCH_HOME=/absolute/path/to/raven/.hutch

# RAVEN_THEMES_ROOT=/path/to/themes        # default: <app>/views/overlay/themes
# RAVEN_ASSET_BASE_URL=views://overlay/themes
# RAVEN_VIEW_URL=views://overlay/index.html
# RAVEN_SETTINGS_PATH=~/Library/Application Support/ai.bodyguard.raven/settings.json
